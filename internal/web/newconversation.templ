package web

import (
	"github.com/spejder/chat/internal/components/button"
	"github.com/spejder/chat/internal/components/dialog"
	"github.com/spejder/chat/internal/components/input"
	"github.com/spejder/chat/internal/components/label"
	"github.com/spejder/chat/internal/components/textarea"
)

// NewConversation renders the dialog that starts a conversation. The shell
// carries it on every page, and the pen in the sidebar opens it. The people
// are fixed when the conversation starts, so the form asks for them here.
//
// The form posts without htmx. The dialog moves its content into the body,
// where htmx would have to read the markup again, and the answer is a
// redirect into the new conversation anyway.
templ NewConversation(form NewConversationForm) {
	@dialog.Dialog(dialog.Props{ID: newConversationDialog, DefaultOpen: form.Open}) {
		@dialog.Content(dialog.ContentProps{Class: "sm:max-w-lg"}) {
			@dialog.Header() {
				@dialog.Title() {
					Start en samtale
				}
				@dialog.Description() {
					Deltagerne kan ikke ændres, når samtalen er startet.
				}
			}
			// The ids carry a prefix, because the page behind the dialog has
			// a write field of its own.
			<form id="new-conversation-form" class="flex flex-col gap-6" method="post" action="/conversations">
				<div class="flex flex-col gap-2">
					@label.Label(label.Props{For: "new-subject"}) {
						Emne
					}
					@input.Input(input.Props{
						ID:       "new-subject",
						Name:     "subject",
						Type:     "text",
						Value:    form.Subject,
						Required: true,
						Attributes: templ.Attributes{
							"maxlength": "200",
							"autofocus": true,
						},
					})
				</div>
				<fieldset class="flex flex-col gap-3">
					<legend class="pb-2 text-sm font-medium">Hvem er med</legend>
					if len(form.People) == 0 {
						<p class="text-sm text-muted-foreground">Der er ingen andre at skrive til endnu.</p>
					}
					for _, person := range form.People {
						<div class="flex items-center gap-2">
							// A native checkbox, because it works with the
							// keyboard and without any script. The component
							// of the registry hides the real input from the
							// keyboard and needs its script.
							<input
								type="checkbox"
								id={ "new-person-" + person.ID.String() }
								name="person"
								value={ person.ID.String() }
								checked?={ form.chose(person.ID) }
								class="size-4 rounded border-input accent-primary"
							/>
							@label.Label(label.Props{For: "new-person-" + person.ID.String()}) {
								{ person.FullName }
							}
						</div>
					}
				</fieldset>
				<div class="flex flex-col gap-2">
					@label.Label(label.Props{For: "new-body"}) {
						Første besked
					}
					@textarea.Textarea(textarea.Props{
						ID:          "new-body",
						Name:        "body",
						Value:       form.Body,
						Rows:        4,
						Placeholder: "Skriv den første besked",
						Attributes: templ.Attributes{
							"required":  true,
							"maxlength": "4000",
						},
					})
				</div>
				@errorMessage(form.Message)
			</form>
			@dialog.Footer() {
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Attributes: dialog.CloseFor(newConversationDialog),
				}) {
					Annuller
				}
				// The button sits outside the form in the footer of the
				// dialog, and the form attribute ties the two together.
				@button.Button(button.Props{
					Type:       button.TypeSubmit,
					Attributes: templ.Attributes{"form": "new-conversation-form"},
				}) {
					Start
				}
			}
		}
	}
}
