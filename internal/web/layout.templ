package web

import "github.com/spejder/chat/assets"

// Layout renders the HTML shell that every page shares.
templ Layout(title, description string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="description" content={ description }/>
			<title>{ title }</title>
			<link rel="icon" type="image/svg+xml" href={ assets.URL("img/favicon.svg") }/>
			<link
				rel="stylesheet"
				href={ assets.URL("dist/styles.css") }
				integrity={ assets.Integrity("dist/styles.css") }
			/>
			<script src={ assets.URL("js/htmx.min.js") } integrity={ assets.Integrity("js/htmx.min.js") } defer></script>
		</head>
		<body class="h-full bg-background text-foreground antialiased">
			{ children... }
		</body>
	</html>
}
