package web

import (
	"github.com/spejder/chat/assets"
	"github.com/spejder/chat/internal/auth"
	"github.com/spejder/chat/internal/components"
	"github.com/spejder/chat/internal/components/button"
)

// Layout renders the HTML shell that every page shares.
templ Layout(title, description string) {
	{{
		// A file that the build has not made yet carries no hash. The
		// attribute then stays out, because an empty integrity is not valid
		// markup and protects nothing.
		styleIntegrity := assets.Integrity("dist/styles.css")
		scriptIntegrity := assets.Integrity("js/htmx.min.js")
	}}
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content="light dark"/>
			<meta name="description" content={ description }/>
			<title>{ title }</title>
			<link rel="icon" type="image/svg+xml" href={ assets.URL("img/favicon.svg") }/>
			<link
				rel="stylesheet"
				href={ assets.URL("dist/styles.css") }
				if styleIntegrity != "" {
					integrity={ styleIntegrity }
				}
			/>
			<script src={ assets.URL("js/htmx.min.js") } if scriptIntegrity != "" {
	integrity={ scriptIntegrity }
} defer></script>
			<!-- The shadcn-templ components that carry behaviour share one bundle, which the server hands out under /components/. -->
			@components.Scripts()
		</head>
		<body class="flex h-full flex-col bg-background text-foreground antialiased">
			@header()
			<div class="flex-1">
				{ children... }
			</div>
		</body>
	</html>
}

// header shows who is signed in, and the way in or out.
templ header() {
	<header class="flex items-center justify-between gap-4 border-b px-6 py-3">
		<a href="/" class="text-sm font-semibold tracking-tight">Chat</a>
		if person, ok := auth.UserFrom(ctx); ok {
			<div class="flex items-center gap-3">
				<span class="text-sm text-muted-foreground">{ person.FullName }</span>
				<form method="post" action="/logout">
					@button.Button(button.Props{
						Type:    button.TypeSubmit,
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
					}) {
						Sign out
					}
				</form>
			</div>
		} else {
			@button.Button(button.Props{
				Href:    "/login",
				Variant: button.VariantOutline,
				Size:    button.SizeSm,
			}) {
				Sign in
			}
		}
	</header>
}
