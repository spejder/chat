package web

import (
	"github.com/spejder/chat/assets"
	"github.com/spejder/chat/internal/auth"
	"github.com/spejder/chat/internal/components/breadcrumb"
	"github.com/spejder/chat/internal/components/button"
	"github.com/spejder/chat/internal/components/dialog"
	"github.com/spejder/chat/internal/components/dropdownmenu"
	"github.com/spejder/chat/internal/components/icon"
	"github.com/spejder/chat/internal/components/separator"
	"github.com/spejder/chat/internal/components/sidebar"
	"github.com/spejder/chat/internal/components/tooltip"
	"github.com/spejder/chat/internal/utils"
)

// Shell wraps every page that a signed in person sees: the sidebar with the
// conversations, a top bar that names the open conversation, and the page
// itself in the rest of the room. It follows the block sidebar-01 of
// shadcn-templ.
templ Shell(page ShellPage) {
	{{ appIntegrity := assets.Integrity("js/app.js") }}
	{{ pushIntegrity := assets.Integrity("js/push.js") }}
	{{ reader, _ := auth.UserFrom(ctx) }}
	@Layout(page.Title, "Samtaler i Chat.") {
		@sidebar.Provider(sidebar.ProviderProps{
			// The height of the window as it is right now, with or without
			// the toolbars of a mobile browser, so a page inside can fill it
			// and scroll on its own instead of growing the whole document.
			Class: "h-dvh",
			// The script writes the sidebar_state cookie, and the server
			// reads it, so the page comes back the way the reader left it.
			DisableDefaultOpen: !page.SidebarOpen,
			// assets/js/app.js reads the mark and opens the sheet on a phone.
			Attributes: templ.Attributes{"data-open-on-phone": page.OpenOnPhone},
		}) {
			@sidebar.Sidebar() {
				@sidebar.Header() {
					@brand()
				}
				@sidebar.Content() {
					@sidebar.Group() {
						@sidebar.GroupLabel() {
							Samtaler
						}
						// The pen opens the dialog. The dialog lives outside
						// the sidebar, because on a phone the sidebar is a
						// sheet that the script moves around.
						// A tooltip names the pen for a mouse. On a phone the
						// group action of the registry already widens its tap
						// area with an invisible frame around the icon.
						@tooltip.Tooltip() {
							@sidebar.GroupAction(sidebar.GroupActionProps{
								Attributes: utils.MergeAttributes(
									tooltip.Trigger(ctx),
									dialog.TriggerFor(newConversationDialog),
								),
							}) {
								@icon.SquarePen()
								<span class="sr-only">Start en samtale</span>
							}
							@tooltip.Content(tooltip.ContentProps{Side: tooltip.SideRight}) {
								Start en samtale
							}
						}
						@sidebar.GroupContent() {
							@ConversationList(page.Summaries, page.Current, page.Version)
						}
					}
				}
				@sidebar.Footer() {
					if page.PushKey != "" {
						@nudge()
					}
					@personMenu(page.PushKey)
				}
				@sidebar.Rail()
			}
			<script src={ assets.URL("js/app.js") } if appIntegrity != "" {
	integrity={ appIntegrity }
} defer></script>
			<script src={ assets.URL("js/push.js") } if pushIntegrity != "" {
	integrity={ pushIntegrity }
} defer></script>
			@sidebar.Inset() {
				<header class="sticky top-0 z-10 flex h-16 shrink-0 items-center gap-2 border-b bg-background px-4">
					@sidebar.Trigger(sidebar.TriggerProps{Class: "-ml-1"})
					if page.Subject != "" {
						@separator.Separator(separator.Props{
							Orientation: separator.OrientationVertical,
							Class:       "mr-2 data-vertical:h-4 data-vertical:self-auto",
						})
						// The subject and the people stay on one line and
						// shorten at the end, because on a phone the top bar
						// is the only place that names the people.
						@breadcrumb.Breadcrumb(breadcrumb.Props{Class: "min-w-0 flex-1"}) {
							@breadcrumb.List(breadcrumb.ListProps{Class: "flex-nowrap"}) {
								@breadcrumb.Item(breadcrumb.ItemProps{Class: "min-w-0 shrink"}) {
									<span class="truncate text-foreground">{ page.Subject }</span>
								}
								@breadcrumb.Separator()
								@breadcrumb.Item(breadcrumb.ItemProps{Class: "min-w-0 flex-1"}) {
									@breadcrumb.Page(breadcrumb.ItemProps{Class: "truncate"}) {
										{ otherNames(page.People, reader.ID) }
									}
								}
							}
						}
					}
				</header>
				{ children... }
			}
		}
		@NewConversation(page.NewConversation)
	}
}

// brand is the name and the mark of the application at the top of the
// sidebar. It leads back to the blank room.
templ brand() {
	@sidebar.Menu() {
		@sidebar.MenuItem() {
			@sidebar.MenuButton(sidebar.MenuButtonProps{
				Size: sidebar.MenuButtonSizeLg,
				Href: "/conversations",
			}) {
				<span class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
					@icon.MessagesSquare(icon.Props{Class: "size-4"})
				</span>
				<span class="font-medium">Chat</span>
			}
		}
	}
}

// personMenu shows who is signed in and the way out. The menu needs a script,
// so a plain form sits behind it for a browser without one.
templ personMenu(pushKey string) {
	{{ person, signedIn := auth.UserFrom(ctx) }}
	if signedIn {
		@sidebar.Menu() {
			@sidebar.MenuItem() {
				@dropdownmenu.DropdownMenu() {
					@sidebar.MenuButton(sidebar.MenuButtonProps{
						Size:       sidebar.MenuButtonSizeLg,
						Class:      "data-popup-open:bg-sidebar-accent data-popup-open:text-sidebar-accent-foreground",
						Attributes: dropdownmenu.Trigger(ctx),
					}) {
						// The initials stand in a span, because a button may
						// hold no div, and the avatar component brings one.
						<span class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-sidebar-accent text-xs font-medium">
							{ initials(person.FullName) }
						</span>
						<span class="grid flex-1 text-left text-sm leading-tight">
							<span class="truncate font-medium">{ person.FullName }</span>
							<span class="truncate text-xs">{ person.Email }</span>
						</span>
						@icon.ChevronsUpDown(icon.Props{Class: "ml-auto size-4"})
					}
					@dropdownmenu.Content(dropdownmenu.ContentProps{
						Class:      "min-w-56 rounded-lg",
						Side:       dropdownmenu.SideRight,
						Align:      dropdownmenu.AlignEnd,
						MobileSide: dropdownmenu.SideBottom,
						SideOffset: 4,
					}) {
						@dropdownmenu.Label(dropdownmenu.LabelProps{Class: "font-normal"}) {
							<div class="grid flex-1 text-left text-sm leading-tight">
								<span class="truncate font-medium">{ person.FullName }</span>
								<span class="truncate text-xs">{ person.Email }</span>
							</div>
						}
						@dropdownmenu.Separator()
						if pushKey != "" {
							@pushSwitch(pushKey, person.ID.String())
						}
						@settingSwitch(
							"/sms-reminders",
							person.SMSReminders,
							"SMS-påmindelser",
							"En SMS, når du går glip af en besked og har slået notifikationer fra på alle dine enheder.",
							icon.MessageSquareText(icon.Props{Class: "size-4 text-muted-foreground"}),
						)
						@settingSwitch(
							"/quiet-nights",
							person.QuietNights,
							"Stille nætter",
							"Fra 22 til 7 er notifikationer lydløse, og SMS-påmindelser venter til morgenen.",
							icon.Moon(icon.Props{Class: "size-4 text-muted-foreground"}),
						)
						@dropdownmenu.Separator()
						// A form, not a menu item: a plain submit works with
						// the keyboard, with no script, and without htmx. The
						// menu item swallowed the click before htmx saw it.
						<form method="post" action="/logout" class="p-1">
							@button.Button(button.Props{
								Type:    button.TypeSubmit,
								Variant: button.VariantGhost,
								Size:    button.SizeSm,
								Class:   "w-full justify-start gap-2",
							}) {
								@icon.LogOut()
								Log ud
							}
						</form>
					}
				}
			}
		}
	}
}

// pushSwitch turns the notifications of this browser on and off. It starts
// hidden, and assets/js/push.js shows it when the browser can receive a
// push, so a browser without push never sees a dead control.
//
// The switch is a native checkbox with the role of a switch. The switch of
// the registry hides its real input from the keyboard and needs its own
// script, and push.js must set the state from outside.
templ pushSwitch(pushKey, personID string) {
	<div data-push hidden class="px-2 py-1.5">
		<label class="flex cursor-pointer items-center justify-between gap-4 text-sm">
			<span class="flex items-center gap-2">
				@icon.Bell(icon.Props{Class: "size-4 text-muted-foreground"})
				Notifikationer
			</span>
			@switchInput(templ.Attributes{
				"data-push-switch": true,
				"data-push-key":    pushKey,
				"data-push-user":   personID,
			})
		</label>
		<p data-push-note hidden class="max-w-56 pt-1 text-xs text-muted-foreground">
			Denne browser blokerer notifikationer fra Chat. Tillad dem i browserens indstillinger.
		</p>
	</div>
}

// settingSwitch is a switch of the person menu that the server keeps for the
// person, not for the browser, so the page renders the state itself.
// assets/js/app.js sends it to the address in data-setting on every change,
// because the person menu moves its content into <body>, where htmx no
// longer listens.
templ settingSwitch(address string, on bool, label, note string, symbol templ.Component) {
	<div class="px-2 py-1.5">
		<label class="flex cursor-pointer items-center justify-between gap-4 text-sm">
			<span class="flex items-center gap-2">
				@symbol
				{ label }
			</span>
			@switchInput(templ.Attributes{
				"name":         "on",
				"value":        "true",
				"checked":      on,
				"data-setting": address,
			})
		</label>
		<p class="max-w-56 pt-1 text-xs text-muted-foreground">
			{ note }
		</p>
	</div>
}

// switchInput is the native checkbox with the role of a switch that both
// switches of the person menu share. The classes copy the look of the
// registry switch.
templ switchInput(attributes templ.Attributes) {
	<span class="relative inline-flex shrink-0 items-center">
		<input
			type="checkbox"
			role="switch"
			class="peer h-[18.4px] w-8 cursor-pointer appearance-none rounded-full border border-transparent bg-input shadow-xs transition-all outline-none checked:bg-primary focus-visible:ring-3 focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 dark:bg-input/80 dark:checked:bg-primary"
			{ attributes... }
		/>
		<span
			aria-hidden="true"
			class="pointer-events-none absolute left-px size-4 rounded-full bg-background transition-transform peer-checked:translate-x-[calc(100%-2px)] dark:bg-foreground dark:peer-checked:bg-primary-foreground"
		></span>
	</span>
}

// nudge suggests the next step towards notifications on this device: the
// home screen on an iPhone, the install button of the browser on a phone,
// or the notifications themselves. It starts hidden, and assets/js/push.js
// shows at most one step, and none to a person who said no. The card is
// plain classes in the look of the registry card, which this one box does
// not justify adding.
templ nudge() {
	<div data-nudge hidden class="flex flex-col gap-3 rounded-lg border bg-card p-3 text-sm text-card-foreground shadow-xs">
		<div data-nudge-step="home" hidden class="flex gap-2">
			@icon.Smartphone(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-muted-foreground"})
			<p>
				<span class="block font-medium">Åbn Chat fra din hjemmeskærm</span>
				<span class="mt-1 block text-muted-foreground">
					En iPhone viser kun notifikationer der. Tryk på Del
					@icon.Share(icon.Props{Class: "inline size-3.5 align-[-2px]"})
					og derefter Føj til hjemmeskærm.
				</span>
			</p>
		</div>
		<div data-nudge-step="install" hidden class="flex gap-2">
			@icon.Smartphone(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-muted-foreground"})
			<p>
				<span class="block font-medium">Installer Chat</span>
				<span class="mt-1 block text-muted-foreground">Åbn den fra din hjemmeskærm som enhver anden app.</span>
			</p>
		</div>
		<div data-nudge-step="notify" hidden class="flex gap-2">
			@icon.Bell(icon.Props{Class: "mt-0.5 size-4 shrink-0 text-muted-foreground"})
			<p>
				<span class="block font-medium">Få besked, når nogen skriver</span>
				<span class="mt-1 block text-muted-foreground">Få en notifikation om nye beskeder, også når Chat er lukket.</span>
			</p>
		</div>
		<div class="flex justify-end gap-2">
			@button.Button(button.Props{
				Variant:    button.VariantGhost,
				Size:       button.SizeSm,
				Attributes: templ.Attributes{"data-nudge-later": true},
			}) {
				Ikke nu
			}
			@button.Button(button.Props{
				Size:       button.SizeSm,
				Attributes: templ.Attributes{"data-nudge-install": true, "hidden": true},
			}) {
				Installer
			}
			@button.Button(button.Props{
				Size:       button.SizeSm,
				Attributes: templ.Attributes{"data-nudge-notify": true, "hidden": true},
			}) {
				Slå til
			}
		</div>
	</div>
}

// initials writes the first letters of a name, for the round mark.
func initials(name string) string {
	out := ""

	for _, part := range splitName(name) {
		out += string([]rune(part)[0])

		if len(out) == 2 {
			break
		}
	}

	return out
}
