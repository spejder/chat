package web

import "github.com/spejder/chat/internal/components/button"

// Home renders the start page.
templ Home() {
	@Layout("Chat", "A chat application built with Go, templ and htmx.") {
		<main class="flex min-h-full items-center justify-center p-6">
			<div class="flex w-full max-w-md flex-col items-center gap-6 rounded-xl border bg-card p-8 text-card-foreground shadow-sm">
				<h1 class="text-3xl font-semibold tracking-tight">Hello world</h1>
				<p class="text-center text-sm text-muted-foreground">
					Served by Go and templ, styled by shadcn-templ, wired by htmx 4.
				</p>
				@button.Button(button.Props{
					Attributes: templ.Attributes{
						"hx-post":   "/greet",
						"hx-target": "#greeting",
						"hx-swap":   "innerHTML",
					},
				}) {
					Say hello
				}
				<div id="greeting" class="min-h-5 text-sm text-muted-foreground" aria-live="polite"></div>
			</div>
		</main>
	}
}
