package web

import (
	"github.com/spejder/chat/assets"
	"github.com/spejder/chat/internal/chat"
	"github.com/spejder/chat/internal/components/button"
	"github.com/spejder/chat/internal/components/textarea"
	"github.com/spejder/chat/internal/user"
)

// ConversationPage renders one conversation with its messages and the field
// to write in it.
templ ConversationPage(conversation chat.Conversation, people []user.User, messages []chat.Message, reader user.User) {
	{{ chatIntegrity := assets.Integrity("js/chat.js") }}
	// The column fills the room. Only the messages scroll, which needs
	// min-h-0, because a flex child otherwise refuses to shrink.
	<div class="flex min-h-0 flex-1 flex-col">
		<div class="flex flex-col gap-1 border-b p-4">
			<h1 class="text-lg font-semibold tracking-tight">{ conversation.Subject }</h1>
			<p class="text-sm text-muted-foreground">{ names(people) }</p>
		</div>
		<div
			id="messages"
			class="flex min-h-0 flex-1 flex-col gap-1 overflow-y-auto p-4"
			data-hx-get={ "/conversations/" + conversation.ID.String() + "/messages" }
			data-hx-trigger="every 3s"
			data-hx-swap="innerHTML"
		>
			@Messages(messages, reader)
		</div>
		@WriteForm(conversation, "")
	</div>
	<script src={ assets.URL("js/chat.js") } if chatIntegrity != "" {
	integrity={ chatIntegrity }
} defer></script>
}

// Messages renders one conversation as bubbles: the reader on the right,
// everybody else on the left. The page asks for this again every few seconds.
templ Messages(messages []chat.Message, reader user.User) {
	if len(messages) == 0 {
		<p class="text-sm text-muted-foreground">No messages yet. Write the first one.</p>
	}
	for _, row := range bubbles(messages, reader) {
		if row.DateLabel != "" {
			<div class="flex justify-center py-2">
				<span class="rounded-full bg-muted px-3 py-1 text-xs text-muted-foreground">
					{ row.DateLabel }
				</span>
			</div>
		}
		if row.ShowName {
			<span class="px-1 pt-2 text-xs text-muted-foreground">{ row.Message.AuthorName }</span>
		}
		<div
			class={ "flex w-full", templ.KV("justify-end", row.Mine), templ.KV("justify-start", !row.Mine) }
		>
			<div
				class={
					"max-w-[75%] rounded-2xl px-3 py-2 text-sm break-words whitespace-pre-wrap",
					templ.KV("bg-primary text-primary-foreground", row.Mine),
					templ.KV("bg-muted text-foreground", !row.Mine),
					templ.KV("rounded-br-sm", row.Mine && row.ShowTime),
					templ.KV("rounded-bl-sm", !row.Mine && row.ShowTime),
				}
			>
				{ row.Message.Body }
				if row.ShowTime {
					<span class="mt-1 block text-right text-xs opacity-70">
						{ clock(row.Message.CreatedAt) }
					</span>
				}
			</div>
		</div>
	}
}

// WriteForm renders the field that writes a message. The answer holds the
// whole message list, so the new message appears at once.
templ WriteForm(conversation chat.Conversation, message string) {
	<form
		id="write"
		class="flex flex-col gap-2 border-t p-4"
		method="post"
		action={ templ.SafeURL("/conversations/" + conversation.ID.String() + "/messages") }
		data-hx-post={ "/conversations/" + conversation.ID.String() + "/messages" }
		data-hx-target="#messages"
		data-hx-swap="innerHTML"
	>
		@textarea.Textarea(textarea.Props{
			ID:          "body",
			Name:        "body",
			Rows:        3,
			Placeholder: "Write a message",
			Attributes: templ.Attributes{
				"required":  true,
				"maxlength": "4000",
				"autofocus": true,
			},
		})
		@errorMessage(message)
		<div class="flex justify-end">
			@button.Button(button.Props{Type: button.TypeSubmit}) {
				Send
			}
		</div>
	</form>
}

// names writes the people of a conversation in one line.
func names(people []user.User) string {
	out := ""

	for i, person := range people {
		if i > 0 {
			out += ", "
		}

		out += person.FullName
	}

	return out
}
