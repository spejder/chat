package web

import (
	"net/url"
	"strconv"
	"time"
	"uuid"

	"github.com/spejder/chat/assets"
	"github.com/spejder/chat/internal/chat"
	"github.com/spejder/chat/internal/components/button"
	"github.com/spejder/chat/internal/components/icon"
	"github.com/spejder/chat/internal/components/textarea"
	"github.com/spejder/chat/internal/user"
)

// ConversationPage renders one conversation with its messages and the field
// to write in it.
templ ConversationPage(conversation chat.Conversation, people []user.User, messages []chat.Message, panel Panel, version string, hasOlder bool) {
	{{ chatIntegrity := assets.Integrity("js/chat.js") }}
	// The column fills the room. Only the messages scroll, which needs
	// min-h-0, because a flex child otherwise refuses to shrink.
	<div class="flex min-h-0 flex-1 flex-col">
		<div class="border-b p-4">
			<div class="mx-auto flex w-full max-w-3xl flex-col gap-1">
				<h1 class="text-lg font-semibold tracking-tight">{ conversation.Subject }</h1>
				<p class="text-sm text-muted-foreground">{ names(people) }</p>
			</div>
		</div>
		// The scroll box keeps the whole width, so the scrollbar stays at the
		// edge of the window. Only the column of messages is centred.
		<div id="messages" class="relative flex min-h-0 flex-1 flex-col overflow-y-auto px-4 py-2">
			<div class="mx-auto flex w-full max-w-3xl flex-col">
				// The older messages live in their own box, so a poll of the
				// newest ones can never throw away what the reader asked to see.
				<div id="older" class="flex flex-col gap-1">
					if hasOlder && len(messages) > 0 {
						@OlderButton(conversation, messages[0].ID)
					}
				</div>
				@MessageList(conversation, messages, panel, version)
			</div>
		</div>
		// One sentence for a screen reader when a message arrives. A live
		// region on the list itself would read the whole list after a swap.
		<p id="announce" class="sr-only" aria-live="polite"></p>
		// Both notices float over the bottom of the list.
		// relative and z-10, because the message list above is positioned and
		// would otherwise paint over them and swallow the click.
		<div class="pointer-events-none relative z-10 flex flex-col items-center gap-1">
			// The notice appears when the line to the server is down.
			<p
				id="offline"
				hidden
				class="-mt-2 rounded-full border bg-background px-3 py-1 text-xs text-muted-foreground shadow-xs"
			>
				The connection is down. Trying again.
			</p>
			// The button appears when a message arrives while the reader looks
			// further up.
			<button
				id="jump"
				type="button"
				hidden
				class="pointer-events-auto -mt-2 rounded-full bg-primary px-3 py-1 text-xs text-primary-foreground shadow-xs transition-colors hover:bg-primary/90"
			>
				New messages
			</button>
		</div>
		@WriteForm(conversation, panel.Since, "")
	</div>
	<script src={ assets.URL("js/chat.js") } if chatIntegrity != "" {
	integrity={ chatIntegrity }
} defer></script>
}

// MessageList holds the messages and the poll. It replaces itself, so the
// answer carries the next version and the page keeps the mark for the unread
// messages.
templ MessageList(conversation chat.Conversation, messages []chat.Message, panel Panel, version string) {
	<div
		id="message-list"
		role="log"
		class="flex flex-col gap-1"
		data-hx-get={ messagesURL(conversation.ID, panel.Since, version) }
		data-hx-trigger="every 3s"
		data-hx-swap="outerHTML"
	>
		@Messages(messages, panel)
	</div>
}

// OlderButton asks for the messages in front of the ones on the page. It
// swaps itself for the answer, which brings the next button with it.
templ OlderButton(conversation chat.Conversation, before uuid.UUID) {
	<button
		type="button"
		class="mx-auto my-2 rounded-full border px-3 py-1 text-xs text-muted-foreground hover:bg-muted"
		data-hx-get={ olderURL(conversation.ID, before) }
		data-hx-swap="outerHTML"
	>
		Show older messages
	</button>
}

// OlderBlock is the answer to that button: the next button, and then the
// block of older messages.
templ OlderBlock(conversation chat.Conversation, messages []chat.Message, panel Panel, hasOlder bool) {
	if hasOlder && len(messages) > 0 {
		@OlderButton(conversation, messages[0].ID)
	}
	@Messages(messages, panel)
}

// Messages renders one conversation as bubbles: the reader on the right,
// everybody else on the left.
templ Messages(messages []chat.Message, panel Panel) {
	if len(messages) == 0 {
		<p class="py-8 text-center text-sm text-muted-foreground">No messages yet. Write the first one.</p>
	}
	for _, row := range bubbles(messages, panel) {
		if row.FirstUnread {
			<div class="flex items-center gap-2 py-3">
				<span class="h-px flex-1 bg-border"></span>
				<span class="text-xs font-medium text-muted-foreground">New messages</span>
				<span class="h-px flex-1 bg-border"></span>
			</div>
		}
		if row.DateLabel != "" {
			// The line stays at the top of the box while the day scrolls
			// under it, so the reader always knows which day this is.
			<div class="sticky top-0 z-10 flex justify-center py-2">
				<span class="rounded-full border bg-background/80 px-3 py-1 text-xs text-muted-foreground shadow-xs backdrop-blur-sm">
					{ row.DateLabel }
				</span>
			</div>
		}
		if row.ShowName {
			<span class="mt-3 px-1 text-xs text-muted-foreground">{ row.Message.AuthorName }</span>
		}
		<div
			data-message
			data-mine?={ row.Mine }
			data-author={ authorLabel(row) }
			class={
				"flex w-full",
				templ.KV("justify-end", row.Mine),
				templ.KV("justify-start", !row.Mine),
				// A new group stands further from the one above it than the
				// messages inside a group stand from each other. The name
				// above a group already brings that room with it.
				templ.KV("mt-3", row.StartsGroup && !row.ShowName && row.DateLabel == ""),
			}
		>
			<div
				title={ fullTime(row.Message.CreatedAt) }
				class={
					"flex max-w-[75%] flex-wrap items-end justify-end gap-x-2 rounded-2xl px-3 py-2 text-sm break-words whitespace-pre-wrap shadow-xs",
					templ.KV("bg-primary text-primary-foreground", row.Mine),
					templ.KV("border bg-muted text-foreground", !row.Mine),
					templ.KV("rounded-br-sm", row.Mine && row.ShowTime),
					templ.KV("rounded-bl-sm", !row.Mine && row.ShowTime),
				}
			>
				<span data-body class="min-w-0">{ row.Message.Body }</span>
				if row.ShowTime {
					// The clock sits at the end of the last line of the text,
					// and drops to a line of its own when there is no room.
					<span class="text-xs opacity-70">
						{ clock(row.Message.CreatedAt) }
					</span>
				}
			</div>
		</div>
		if row.ReadMark != "" {
			<span class="px-1 pt-1 text-right text-xs text-muted-foreground">{ row.ReadMark }</span>
		}
	}
}

// WriteForm renders the field that writes a message. The answer holds the
// whole message list, so the new message appears at once.
templ WriteForm(conversation chat.Conversation, since time.Time, message string) {
	<form
		id="write"
		data-conversation={ conversation.ID.String() }
		class="border-t p-4"
		method="post"
		action={ templ.SafeURL("/conversations/" + conversation.ID.String() + "/messages") }
		data-hx-post={ "/conversations/" + conversation.ID.String() + "/messages" }
		data-hx-target="#message-list"
		data-hx-swap="outerHTML"
	>
		<div class="mx-auto flex w-full max-w-3xl flex-col gap-2">
			if !since.IsZero() {
				<input type="hidden" name="since" value={ strconv.FormatInt(since.Unix(), 10) }/>
			}
			// The field and the button sit in one rounded box, so the two read
			// as one control.
			<div class="flex items-end gap-2 rounded-2xl border bg-background p-1.5 shadow-xs focus-within:ring-[3px] focus-within:ring-ring/50">
				@textarea.Textarea(textarea.Props{
					ID:          "body",
					Name:        "body",
					Rows:        1,
					Class:       "max-h-48 min-h-8 resize-none border-0 bg-transparent px-2 py-1 shadow-none focus-visible:ring-0",
					Placeholder: "Write a message",
					Attributes: templ.Attributes{
						// The hint lives in the title, not in the placeholder. The
						// field sizes itself to its content, so a long placeholder
						// makes the field two lines tall on a phone.
						"title":     "Enter sends the message, Shift and Enter write a new line",
						"required":  true,
						"maxlength": "4000",
						"autofocus": true,
						"data-grow": true,
					},
				})
				@button.Button(button.Props{
					Type:  button.TypeSubmit,
					Size:  button.SizeIcon,
					Class: "shrink-0 rounded-full",
				}) {
					@icon.Send(icon.Props{Class: "size-4"})
					<span class="sr-only">Send</span>
				}
			</div>
			@errorMessage(message)
		</div>
	</form>
}

// names writes the people of a conversation in one line.
func names(people []user.User) string {
	out := ""

	for i, person := range people {
		if i > 0 {
			out += ", "
		}

		out += person.FullName
	}

	return out
}

// messagesURL points the poll at the list. The version lets the server answer
// that nothing changed, and the mark keeps the line for the unread messages
// where it is.
func messagesURL(conversationID uuid.UUID, since time.Time, version string) string {
	address := "/conversations/" + conversationID.String() + "/messages?v=" + url.QueryEscape(version)

	if !since.IsZero() {
		address += "&since=" + strconv.FormatInt(since.Unix(), 10)
	}

	return address
}

// authorLabel names the writer of a message for the hidden line that a screen
// reader hears.
func authorLabel(row bubble) string {
	if row.Mine {
		return "You"
	}

	return row.Message.AuthorName
}

// olderURL points the button at the messages in front of one message.
func olderURL(conversationID, before uuid.UUID) string {
	return "/conversations/" + conversationID.String() + "/older?before=" + before.String()
}
