package web

import (
	"net/url"
	"strconv"
	"time"
	"uuid"

	"github.com/spejder/chat/internal/chat"
	"github.com/spejder/chat/internal/components/badge"
	"github.com/spejder/chat/internal/components/button"
	"github.com/spejder/chat/internal/components/dialog"
	"github.com/spejder/chat/internal/components/icon"
	"github.com/spejder/chat/internal/components/sidebar"
)

// Conversations is the page behind /conversations. The list lives in the
// sidebar, so the room only shows the mark of the application until the
// reader picks a conversation. The mark is the shape of the favicon, in a
// muted colour with the dots cut out.
templ Conversations() {
	<div class="flex flex-1 items-center justify-center p-8">
		<svg
			data-mark
			xmlns="http://www.w3.org/2000/svg"
			viewBox="0 0 32 32"
			aria-hidden="true"
			class="size-32 text-muted-foreground/25"
		>
			<path class="fill-current" d="M6 4h20a4 4 0 0 1 4 4v12a4 4 0 0 1-4 4H14l-8 6v-6a4 4 0 0 1-4-4V8a4 4 0 0 1 4-4Z"></path>
			<circle class="fill-background" cx="11" cy="14" r="2"></circle>
			<circle class="fill-background" cx="16" cy="14" r="2"></circle>
			<circle class="fill-background" cx="21" cy="14" r="2"></circle>
		</svg>
	</div>
}

// ConversationList renders the lines of the sidebar. It replaces itself every
// ten seconds, so the answer carries the next version, and it holds the total
// of unread messages, which the tab title reads.
templ ConversationList(summaries []chat.Summary, current uuid.UUID, version string) {
	@sidebar.Menu(sidebar.MenuProps{
		ID: "conversation-list",
		Attributes: templ.Attributes{
			"data-unread":     strconv.Itoa(unreadTotal(summaries)),
			"data-hx-get":     listURL(current, version),
			"data-hx-trigger": "every 10s",
			"data-hx-swap":    "outerHTML",
		},
	}) {
		if len(summaries) == 0 {
			<li class="flex flex-col items-start gap-3 px-2 py-1.5 text-sm text-muted-foreground">
				No conversations yet.
				@button.Button(button.Props{
					Variant:    button.VariantOutline,
					Size:       button.SizeSm,
					Attributes: dialog.TriggerFor(newConversationDialog),
				}) {
					@icon.SquarePen()
					Start a conversation
				}
			</li>
		}
		{{ now := time.Now() }}
		for _, summary := range summaries {
			{{ unread := summary.Unread > 0 }}
			@sidebar.MenuItem() {
				// Two lines like a phone: the subject and the time, then
				// the newest message and the count of unread ones. An
				// unread conversation carries a bold subject and a dark
				// badge, so it stands out at a glance.
				@sidebar.MenuButton(sidebar.MenuButtonProps{
					Href:       "/conversations/" + summary.ID.String(),
					IsActive:   summary.ID == current,
					Size:       sidebar.MenuButtonSizeLg,
					Attributes: currentPage(summary.ID == current),
				}) {
					<span class="flex min-w-0 flex-1 flex-col gap-0.5">
						<span class="flex items-center gap-2">
							<span class={ "truncate", templ.KV("font-semibold", unread) }>{ summary.Subject }</span>
							<span class={ "ml-auto shrink-0 text-xs", templ.KV("text-muted-foreground", !unread), templ.KV("font-medium", unread) }>
								{ listTime(summary.LastMessageAt, now) }
							</span>
						</span>
						<span class="flex items-center gap-2">
							<span class={ "truncate text-xs", templ.KV("text-muted-foreground", !unread) }>{ preview(summary) }</span>
							if unread {
								@badge.Badge(badge.Props{Class: "ml-auto h-5 min-w-5 shrink-0 rounded-full px-1.5 tabular-nums"}) {
									// The space sits inside the expression, because
									// templ drops the white space between an
									// expression and a tag.
									{ strconv.Itoa(summary.Unread) }<span class="sr-only">{ " unread" }</span>
								}
							}
						</span>
					</span>
				}
			}
		}
	}
}

// unreadTotal counts the messages that this person has not read, over every
// conversation.
func unreadTotal(summaries []chat.Summary) int {
	total := 0

	for _, summary := range summaries {
		total += summary.Unread
	}

	return total
}

// listURL points the poll at the list. It names the open conversation, so the
// mark survives the swap, and the version, so the server can answer that
// nothing changed.
func listURL(current uuid.UUID, version string) string {
	address := "/conversations/list?v=" + url.QueryEscape(version)

	if current != uuid.Nil() {
		address += "&current=" + current.String()
	}

	return address
}

// currentPage marks the line of the open conversation for a screen reader.
func currentPage(open bool) templ.Attributes {
	if !open {
		return nil
	}

	return templ.Attributes{"aria-current": "page"}
}
