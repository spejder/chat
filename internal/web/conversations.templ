package web

import (
	"net/url"
	"strconv"
	"uuid"

	"github.com/spejder/chat/internal/chat"
	"github.com/spejder/chat/internal/components/badge"
	"github.com/spejder/chat/internal/components/button"
)

// Conversations is the page behind /conversations: the list lives in the
// sidebar, so the room itself only says what to do next.
templ Conversations() {
	<div class="flex flex-1 flex-col items-start gap-4 p-6">
		<p class="text-sm text-muted-foreground">
			Pick a conversation on the left, or start a new one.
		</p>
		@button.Button(button.Props{Href: "/conversations/new"}) {
			Start a conversation
		}
	</div>
}

// ConversationList renders the lines of the sidebar. It replaces itself every
// ten seconds, so the answer carries the next version, and it holds the total
// of unread messages, which the tab title reads.
templ ConversationList(summaries []chat.Summary, current uuid.UUID, version string) {
	<div
		id="conversation-list"
		class="flex flex-col"
		data-unread={ strconv.Itoa(unreadTotal(summaries)) }
		data-hx-get={ listURL(current, version) }
		data-hx-trigger="every 10s"
		data-hx-swap="outerHTML"
	>
		@conversationLines(summaries, current)
	</div>
}

// conversationLines draws one line per conversation.
templ conversationLines(summaries []chat.Summary, current uuid.UUID) {
	if len(summaries) == 0 {
		<p class="p-4 text-sm text-muted-foreground">
			You take part in no conversation yet.
		</p>
	}
	for _, summary := range summaries {
		<a
			href={ templ.SafeURL("/conversations/" + summary.ID.String()) }
			class="flex flex-col items-start gap-1 border-b p-4 text-sm leading-tight whitespace-nowrap last:border-b-0 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground data-active:bg-sidebar-accent data-active:text-sidebar-accent-foreground"
			data-active?={ summary.ID == current }
			if summary.ID == current {
				aria-current="page"
			}
		>
			<span class="flex w-full items-center gap-2">
				<span class="truncate font-medium">{ summary.Subject }</span>
				<span class="ml-auto text-xs">{ shortTime(summary.LastMessageAt) }</span>
			</span>
			<span class="flex w-full items-center gap-2">
				<span class="truncate text-xs text-muted-foreground">{ summary.Others }</span>
				if summary.Unread > 0 {
					<span class="ml-auto">
						@badge.Badge() {
							{ strconv.Itoa(summary.Unread) } new
						}
					</span>
				}
			</span>
		</a>
	}
}

// unreadTotal counts the messages that this person has not read, over every
// conversation.
func unreadTotal(summaries []chat.Summary) int {
	total := 0

	for _, summary := range summaries {
		total += summary.Unread
	}

	return total
}

// listURL points the poll at the list. It names the open conversation, so the
// mark survives the swap, and the version, so the server can answer that
// nothing changed.
func listURL(current uuid.UUID, version string) string {
	address := "/conversations/list?v=" + url.QueryEscape(version)

	if current != uuid.Nil() {
		address += "&current=" + current.String()
	}

	return address
}
