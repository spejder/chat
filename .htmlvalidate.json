{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "doctype-style": "off",
    "no-unknown-attributes": "off",
    "no-inline-style": "off",
    "form-dup-name": [
      "error",
      {
        "shared": [
          "radio",
          "checkbox",
          "submit",
          "button",
          "reset"
        ]
      }
    ],
    "prefer-native-element": "off"
  }
}
